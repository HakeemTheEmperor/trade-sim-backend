# =============================================================================
# Trade Sim Backend — environment variables
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Loaded via python-dotenv in app/__init__.py and by docker-compose (env_file).
# =============================================================================

# --- Database --------------------------------------------------------------
# Postgres credentials + database name. Under docker-compose these configure the
# `db` service AND are interpolated into SQLALCHEMY_DATABASE_URI for the app
# service (docker-compose.yml derives the URI from them, so there's a single
# source of truth and the two can't drift).
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=myappdb

# Postgres major version for the db service image. Pinned (not `latest`) so an
# upstream bump can't refuse to open a volume created by an older version.
POSTGRES_VERSION=16

# Published host ports (host:container). Change these if 5432/5000 are already
# taken on your machine; they don't affect the in-network URI, which always uses
# the container's internal 5432.
DB_PORT=5432
APP_PORT=5000

# NOTE: bootstrap.sh binds gunicorn to $PORT, falling back to 5000. Hosting
# platforms (Render) inject PORT themselves, so do NOT set it here — a value in
# this file would override the platform's and the service would bind the wrong
# port, which reads as "no open ports detected" and fails the deploy.

# SQLAlchemy connection string. Used directly when running OUTSIDE docker (local
# pipenv). Under docker-compose it is overridden by the value built from the
# POSTGRES_* vars above (host = the `db` service). Keep the two consistent.
SQLALCHEMY_DATABASE_URI=postgresql://admin:secret@db:5432/myappdb
# Leave "False" unless you need SQLAlchemy modification tracking.
SQLALCHEMY_TRACK_MODIFICATIONS=False

# --- Auth / JWT ------------------------------------------------------------
# Secret used to sign JWTs. SERVER-ONLY — never expose this to the client.
# Must be long and random; anyone with it can forge tokens for any user/role.
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Access token lifetime in hours (default 6).
JWT_ACCESS_TOKEN_EXPIRES=6

# The JWT is stored in an HttpOnly cookie. Keep Secure=True in production (HTTPS);
# set False only for local dev over http:// or the browser won't store the cookie.
JWT_COOKIE_SECURE=True
# SameSite policy. "Lax" is correct when FE and BE share a registrable domain
# (e.g. app.imockmarket.toluwalase.me + api-imockmarket.toluwalase.me).
JWT_COOKIE_SAMESITE=Lax

# Domain the session cookies are scoped to. REQUIRED when the frontend and API
# live on different subdomains — set it to the shared parent, with a leading dot:
#   JWT_COOKIE_DOMAIN=.toluwalase.me
#
# Leave EMPTY for local development (both on localhost).
#
# Getting this wrong fails in a confusing way rather than an obvious one. Unset,
# the cookies are host-only: the browser still SENDS them to the API that set
# them, so signing in and every GET works and the session looks healthy. But the
# CSRF cookie has to be READ by JavaScript on the frontend origin, and JS cannot
# read a cookie scoped to a different host. The X-CSRF-TOKEN header goes missing,
# the API answers 401 "Missing CSRF token", and the client reads that as an
# expired session and logs the user out. Symptom: "browsing is fine, but any
# action logs me out".
JWT_COOKIE_DOMAIN=

# --- Seed admin user -------------------------------------------------------
# Super-admin account created on startup (app/__init__.py: create_admin()).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Swagger UI ------------------------------------------------------------
# URL prefix the Swagger UI is served under (e.g. /docs) ...
SWAGGER_URL=/docs
# ... and the path to the OpenAPI spec it loads.
#
# Use /openapi.yaml (the default). That route serves the spec with the
# `servers:` entry rewritten from PUBLIC_API_BASE_URL below, so Swagger's
# "Try it out" calls the deployed API. The old /static/openapi.yaml value still
# works but serves the file verbatim, whose servers entry is hardcoded to
# localhost — which is why the deployed docs used to fire requests at 127.0.0.1.
API_URL=/openapi.yaml

# Public origin of THIS api, used for the `servers:` entry above. Scheme + host
# only, no path and no trailing slash:
#   PUBLIC_API_BASE_URL=https://api-imockmarket.toluwalase.me
# The /api/v1 prefix is appended automatically (api_base_url() in
# app/__init__.py), and a value that already ends in it is left alone.
# Unset -> http://localhost:$PORT (5000), matching bootstrap.sh.
#
# NOTE: this is unrelated to API_URL above, despite the similar name. API_URL is
# where the spec document lives; this is the host the spec tells clients to call.
PUBLIC_API_BASE_URL=

# --- App / CORS ------------------------------------------------------------
# Comma-separated list of allowed browser origins. Must be explicit (never "*")
# because cookie auth uses credentialed requests. Set the deployed frontend
# origin plus your local dev origin.
# NOTE: cookie auth requires FE and BE to be same-site (same registrable
# domain), e.g. app.imockmarket.toluwalase.me + api-imockmarket.toluwalase.me.
CORS_ORIGINS=https://app.imockmarket.toluwalase.me,http://localhost:5173
# Logging verbosity (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# --- Trusted proxies -------------------------------------------------------
# How many reverse proxies sit in front of this app. These are MEASURED values
# for this deployment -- Render contributes two hops of its own, not one:
#   0 = no proxy (running locally / docker-compose directly)
#   2 = Render only (Cloudflare DNS-only / grey cloud)
#   3 = Cloudflare proxied (orange cloud) -> Render   <- current production
#
# Don't trust these numbers blindly; a platform can change its internal
# topology. Re-verify with LOG_CLIENT_IP after any infrastructure change.
#
# This drives ProxyFix, which reads the Nth X-Forwarded-For entry FROM THE
# RIGHT. It MUST match the real topology. Setting it too high is a security
# bug: the extra entry is supplied by the client, so anyone could forge their
# own IP and bypass the IP-based rate limits on signup/signin.
#
# Verify rather than assume: set LOG_CLIENT_IP=true below, hit any endpoint
# from a known network, and confirm the logged remote_addr is that network's
# real public IP.
TRUSTED_PROXY_HOPS=3

# Logs remote_addr + X-Forwarded-For on every request. Use only while
# confirming TRUSTED_PROXY_HOPS, then set back to false — it logs a client
# identifier for each request.
LOG_CLIENT_IP=false
# Whether this process runs the price scheduler + Finnhub websocket listener.
# Keep "true" for the single-process deployment; set "false" on extra web
# workers/instances so only one process runs the background jobs.
RUN_BACKGROUND_JOBS=true

# --- External market-data providers ---------------------------------------
# All provider endpoints are assembled in ONE place: app/integrations/providers.py.
# Only base URLs + keys live here; the endpoint paths live in that module. Leave
# the *_BASE_URL / *_WS_URL values unset to use the built-in defaults; override
# only to point at a sandbox or a different API version.

# Financial Modeling Prep — used to seed available stock prices (app/data_seed.py).
FMP_API_KEY=
# Optional base override (default: https://financialmodelingprep.com/stable).
FMP_BASE_URL=

# Finnhub real-time price websocket (app/websocket_listener.py).
FINNHUB_WS_URL=wss://ws.finnhub.io
FINNHUB_API_KEY=

# Massive, formerly Polygon.io — backfills daily price history
# (app/utils/update_history.py). Keys and accounts carried over in the rebrand.
POLYGON_API_KEY=
# Optional base override (default: https://api.massive.com). The old
# https://api.polygon.io still works if you'd rather pin it.
POLYGON_BASE_URL=

# Currency exchange-rate API (exchangerate-api.com). Base URL INCLUDING the key
# segment but WITHOUT a trailing /pair or /latest, e.g.
#   https://v6.exchangerate-api.com/v6/YOUR-KEY
# The app calls /latest/{base} (one request returns all target rates) and caches
# each rate until the provider's own time_next_update_unix, so on the free tier
# (daily updates) it uses ~1 request/day and is never staler than the data itself.
EXCHANGE_RATE_API=
# Fallback freshness window (hours) used only when a cached rate has no
# next_update timestamp. Default 24.
EXCHANGE_RATE_TTL_HOURS=24

# --- Trading costs ---------------------------------------------------------
# Modelled on how brokers actually earn in 2026: the bid-ask spread on trades
# and the markup on currency conversion, not flat commissions. See
# app/utils/fees.py. Both are fractions, not percentages (0.005 = 0.5%).
#
# WARNING: changing these mid-season changes leaderboard fairness — two players
# making identical trades in different seasons would pay different costs. Prefer
# changing them at a season boundary.

# Half-spread applied either side of the quoted price: buys execute above it,
# sells below. 0.0005 = 5 basis points, so a round trip costs about 0.1%.
TRADE_HALF_SPREAD=0.0005

# Markup taken from the converted amount on a cross-currency transfer.
# 0.005 = 0.5%, mid-range for retail (Wise/Revolut ~0.3-0.6%, brokers up to
# 1.5%). Same-currency transfers convert nothing and so cost nothing.
FX_SPREAD=0.005

# --- Leaderboard -----------------------------------------------------------
# Length of a ranking season in days. Money persists across seasons; only the
# ranking resets, and each season rebaselines to the equity a player holds when
# it opens.
#
# 90 (quarterly): a year is too long for a friend group to stay engaged and too
# long to recover from a bad start.
SEASON_LENGTH_DAYS=90

# How far into a season an account can still be created and be ranked in it.
# Signing up inside this window enrols you immediately with your own starting
# equity as the baseline; after it, you wait for the next season.
#
# Without a grace window the rule is binary — sign up a minute after a season
# opens and you are unrankable for the whole quarter, which for a young app is
# every new user. 0 excludes everyone not present at the open; setting it equal
# to SEASON_LENGTH_DAYS ranks everybody always.
SEASON_JOIN_GRACE_DAYS=30

# Rankings live in named leagues people opt into with a join code, not in an
# automatic board built from your shadow links.
#
# Members per league. 50 covers any real friend group, course or office team,
# keeps the table to one screen, and bounds how far a publicly-posted join code
# can spread your return. A snapshot-backed table would serve far more; this cap
# is a product decision, not a performance limit.
MAX_LEAGUE_MEMBERS=50

# Leagues per user. A member cap alone doesn't stop one person joining hundreds,
# each a set of strangers who can see their return.
MAX_LEAGUES_PER_USER=5

# --- Transactional email (Brevo) -------------------------------------------
# Delivers the 6-digit signup verification code. See docs/email-verification.md.
#
# LEAVE BREVO_API_KEY EMPTY FOR LOCAL DEV. With no key the code is written to
# the log (WARNING level, "code=123456") instead of being emailed, so the whole
# verification flow works with no Brevo account.
#
# REQUIRED IN PRODUCTION. Without it signup still returns 201 and no user can
# ever verify, because the code only ever reaches the log.
BREVO_API_KEY=

# Sender address. Required once BREVO_API_KEY is set, and it must be a sender
# Brevo has verified (a confirmed address, or better, an SPF/DKIM-authenticated
# domain). An unverified sender is ACCEPTED by the API and then silently not
# delivered — indistinguishable from a code that never arrives.
BREVO_SENDER_EMAIL=
# Display name on the email. Optional, defaults to "iMockMarket".
BREVO_SENDER_NAME=iMockMarket

# Optional base override (default: https://api.brevo.com/v3). Leave unset in
# production; set it only to point at a sandbox.
BREVO_BASE_URL=
